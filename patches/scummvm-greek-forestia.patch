+CastMemberID DirectorEngine::resolvePaletteId(CastMemberID id) {
+	// Reference to internal palettes
+	if (id.member < 0) {
+		id.castLib = -1; // Ensure we use the default palette set
+		return id;
+	}
+
+	// Some D5/D6 movies (e.g. Forestia, authored on Mac with a shared
+	// external palette cast) store a cast library number of 0 for bitmap
+	// palettes, meaning the palette is not bound to a specific cast library.
+	// Resolve it by finding a loaded palette with a matching member number,
+	// preferring the lowest cast library number.
+	if (id.castLib == 0 && id.member > 0) {
+		CastMemberID best;
+		for (auto &it : _loadedPalettes) {
+			if (it._key.member == id.member && it._key.castLib > 0 &&
+					(best.isNull() || it._key.castLib < best.castLib))
+				best = it._key;
+		}
+		if (!best.isNull())
+			return best;
+	}
+
+	return id;
+}
