+// Blend an anti-aliased source (e.g. rich text) with the destination, using
+// the per-pixel coverage in srfAlpha. True colour only.
+void DirectorPlotData::inkBlitAlpha(Common::Rect &srcRect) {
+	const Graphics::PixelFormat &pf = d->_wm->_pixelformat;
+	const int bpp = pf.bytesPerPixel;
+	const int srcX = abs(srcRect.left - destRect.left);
+	const int srcY = abs(srcRect.top - destRect.top);
+
+	for (int i = 0; i < destRect.height(); i++) {
+		int sy = srcY + i;
+		int dy = destRect.top + i;
+		if (sy < 0 || sy >= srf->h || sy >= srfAlpha->h || dy < 0 || dy >= dst->h)
+			continue;
+
+		for (int j = 0; j < destRect.width(); j++) {
+			int sx = srcX + j;
+			int dx = destRect.left + j;
+			if (sx < 0 || sx >= srf->w || sx >= srfAlpha->w || dx < 0 || dx >= dst->w)
+				continue;
+
+			int a = *(const byte *)srfAlpha->getBasePtr(sx, sy);
+			// Sprite blend: same convention as InkPrimitives (alpha weights dst)
+			if (alpha)
+				a = a * (255 - CLIP(alpha, 0, 255)) / 255;
+			if (a == 0)
+				continue;
+
+			uint32 src = (bpp == 2) ? *(const uint16 *)srf->getBasePtr(sx, sy) : *(const uint32 *)srf->getBasePtr(sx, sy);
+			uint32 out = src;
+
+			if (a < 255) {
+				uint32 cur = (bpp == 2) ? *(const uint16 *)dst->getBasePtr(dx, dy) : *(const uint32 *)dst->getBasePtr(dx, dy);
+				byte rS, gS, bS, rD, gD, bD;
+				pf.colorToRGB(src, rS, gS, bS);
+				pf.colorToRGB(cur, rD, gD, bD);
+				out = pf.RGBToColor(
+					(rS * a + rD * (255 - a)) / 255,
+					(gS * a + gD * (255 - a)) / 255,
+					(bS * a + bD * (255 - a)) / 255);
+			}
+
+			if (bpp == 2)
+				*(uint16 *)dst->getBasePtr(dx, dy) = out;
+			else
+				*(uint32 *)dst->getBasePtr(dx, dy) = out;
+		}
+	}
+}
+
 } // End of namespace Director
