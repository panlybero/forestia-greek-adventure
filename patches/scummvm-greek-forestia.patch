+bool RichTextCastMember::usesAlphaBlend(InkType ink) {
+	// Anti-aliased rich text drawn with these inks is blended with whatever is
+	// underneath. Rendering it against its background colour and then keying
+	// that colour out leaves a halo of half-blended pixels around the glyphs.
+	return g_director->_wm->_pixelformat.bytesPerPixel > 1 &&
+		(ink == kInkTypeBackgndTrans || ink == kInkTypeMatte || ink == kInkTypeBlend ||
+		 ink == kInkTypeTransparent);
 }
 
